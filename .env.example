# ---- Required for a real deployment ------------------------------------------------
# Any Postgres: Neon / Supabase / RDS. Use the POOLED connection string on serverless hosts.
# (POSTGRES_URL, set by the Supabase/Neon Vercel integrations, works too.) See docs/DEPLOY.md for Supabase.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Your owner link will be /a/<OWNER_TOKEN>. At least 20 letters, digits, - or _. Generate one:
#   openssl rand -base64 24 | tr '+/' '-_' | tr -d '='
OWNER_TOKEN=

# ---- Optional ------------------------------------------------------------------------
STUDIO_NAME=Design by Aarav
# Studio WhatsApp number with country code, digits only. Used for client "message us" / AMC renewal links.
STUDIO_PHONE=919876543210
# Enables the owner's "Rewrite with AI" button (the only LLM call).
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-5-5
# Keep the pool tiny on serverless hosts (each instance opens its own).
PG_POOL_MAX=1

# ---- Local development only ---------------------------------------------------------
# With no DATABASE_URL the app uses a JSON file in DATA_DIR and seeds public demo links.
# DATA_DIR=.data
# DEMO_HUB=on|off   (unset = on locally, always OFF when DATABASE_URL is set; never turn it on in production)
